model Sessions {
  sessionId String @id @unique @map("session_id")

  // 1-to-many relationship with Users
  userId String @map("user_id")
  user   Users  @relation(fields: [userId], references: [id])

  userAgent String? @map("user_agent")
  ip        String? @map("ip")

  tokenHashed String  @unique @map("token_hashed")
  familyId    String  @unique @map("family_id")
  replaceById String? @unique @map("replace_by_id")

  expiresAt DateTime  @map("expires_at")
  revokeAt  DateTime? @map("revoke_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}
